# Copy to .env.local. Never commit real secrets.
NODE_ENV=development
LOG_LEVEL=info
API_PORT=4200
REALTIME_PORT=2567
DATABASE_URL=pglite://.data/pglite
# DATABASE_URL=postgres://gukirana:gukirana@localhost:5432/gukirana   (with pnpm infra:up)
JWT_SECRET=dev-only-jwt-secret-change-me-please
INTERNAL_SERVICE_TOKEN=dev-internal-service-token
API_INTERNAL_URL=http://127.0.0.1:4200
VALKEY_URL=redis://localhost:6379
NATS_URL=nats://localhost:4222
PAYMENTS_PROVIDER=fake
COIN_VALUE_RWF=10
# P3-FGT-09 practice corner refresh (Stars for stamina, practice vs the AI only); both default off
FF_FIGHT_BOOST=0
NEXT_PUBLIC_FF_FIGHT_BOOST=0
# P3-FGT-10 fight skill rating (Glicko-2): rating on the result card, skill report, leaderboard; default on (0 = off)
FF_FIGHT_RATING=1
NEXT_PUBLIC_FF_FIGHT_RATING=1
# P3-FGT-15 first-person fight camera ("My eyes": your own gloves, arms, body and legs in view), offered as an option;
# the side broadcast camera stays the default until first person meets the realism rubric (QA-HUM-01,
# docs/QA/human-realism). 1 / unset = offered, 0 = not offered
NEXT_PUBLIC_FF_FIGHT_FPV=1
# P2-WLD-19 time of day (real Kigali clock / Morning / Midday / Sunset / Night, per player, client side only);
# 1 = on, 0 = off (the classic morning, no time chip); unset = on in development, off in production builds
NEXT_PUBLIC_FF_TIME_OF_DAY=1
# P2-MM-05 matchmaking v2 (find an opponent per game + stake set, challenges across halls, reserved table + walk,
# guided Quick Play; docs/MATCHMAKING-V2.md); 1 / unset = on, 0 = the v1 Quick Match / in-room challenge flows
FF_MATCH_V2=1
NEXT_PUBLIC_FF_MATCH_V2=1
# P3-FGT-18 boxer realism v7 (proportions, loose satin trunks, flat vest, stitched headgear, broadcast ring lighting
# with shadows + AO, re-keyed guard; docs/FIGHT-REALISM-V7.md); 1 / unset = on, 0 = the P3-FGT-17 ring people
NEXT_PUBLIC_FF_BOXER_V7=1
# P3-FGT-19B fighter v8 (the fighters rebuilt from the v8 design, docs/FIGHT-REALISM-V8.md); 1 / unset = on,
# 0 = the v7 people (the fallback). Dev builds: ?boxer=v7|v8 on a lab URL picks per page
NEXT_PUBLIC_FF_BOXER_V8=1
